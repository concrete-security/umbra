# Production environment template. Contains identifiers only, never secrets or
# personal data. Replace all reserved example values before deploying.
# Merged with .env.common + .env.admin + .env.prod.secrets; keys must be unique.
ENV=prod
LETSENCRYPT_STAGING=false
CONSOLE_HOST=console.example.com
CONSOLE_URL=https://console.example.com
VM_PUBLIC_IP=192.0.2.10
UMBRA_CLI_WORKFLOW_BRANCH=main
JWT_PRIVATE_KEY_REF=file:///etc/umbra/jwt/private-prod.pem
JWT_ACTIVE_KID=prod-key-1
# The supported publisher is GHCR-only. Replace the reserved owner.
SECURITY_CVM_IMAGE_REPOSITORY=ghcr.io/example/umbra-security-cvm
DEV_CVM_IMAGE_REPOSITORY=ghcr.io/example/umbra-dev-cvm
