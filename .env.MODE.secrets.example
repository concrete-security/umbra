# This environment's service secrets + image pins. Per environment/host. gitignored.
# Copy to .env.<mode>.secrets (e.g. .env.staging.secrets) and fill in. One of the four merged
# layers; every key must be UNIQUE across them — build-env ABORTS on a key defined twice.
# NEVER commit the filled-in .env.<mode>.secrets.

# Google OIDC -- the CONSOLE-SIDE Google OAuth clients. The `umbra` CLI never sees these:
# it sends only the logical client id `umbra-cli-v1` (in OIDC_CLIENT_ALLOWLIST, .env.common)
# and both login flows are Console-proxied. So dedicated per-environment Google OAuth clients are
# just new value pairs here -- no CLI rebuild, no per-developer config.
#
# Loopback/browser flow (umbra auth login, dashboard): a Google "Web application" client with
# the callback redirect URI. See docs/operator-setup.md §3.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Device-code flow (umbra auth login --device, make verify, CI): a SEPARATE Google client of
# type "TVs and Limited Input devices" -- a "Web application" client cannot do the device grant.
# Leave BOTH unset to reuse the Web client above (fine for browser-only envs; --device / make
# verify will then fail against a Web client).
GOOGLE_OIDC_DEVICE_CLIENT_ID=
GOOGLE_OIDC_DEVICE_CLIENT_SECRET=

# Cloudflare DNS. API token scoped to the zone(s): one zone for the Console hostname,
# a second for per-Security-CVM hostnames.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_BASE_DOMAIN=dev.example.com
SECURITY_CVM_ZONE_ID=
SECURITY_CVM_BASE_DOMAIN=sc.example.com

# Phala (TDX CVM provisioning). Each environment MUST use its OWN Phala workspace + API token.
# Isolation is by workspace/token, NOT by ENV or CVM-name prefix: the token ALONE selects the
# project (there is no project-id field -- see PhalaClient.from_settings), and every CVM is named
# `umbra-v0-*` regardless of ENV (hardcoded in routes.py / tee_provider/phala.py). Because
# `make clean-phala` (run at the start of every staging CI run) and `make verify` teardown DELETE
# every `umbra-v0-*` CVM the token can see, a token shared with prod would delete prod's live
# CVMs. Use a dedicated workspace so `phala cvms list` returns only this environment's CVMs.
PHALA_API_TOKEN=

# Bearer token guarding GET /metrics (Prometheus scrape). While empty, /metrics returns 503
# "metrics token is not configured" -- set it on any environment you actually scrape.
METRICS_TOKEN=

# Profile secret-injection key-encryption key. 32 random bytes, base64:  openssl rand -base64 32
# MUST stay stable for the life of the deployment -- rotating it makes stored secrets undecryptable.
SECRET_INJECTION_KEK_B64=

# Digest-only CVM runtime refs plus the shared dstack-guest TDX MRTD. The Dev
# canary observes that guest baseline; it is not an app-image measurement.
# DEV_CVM_IMAGE_MEASUREMENT and SECURITY_CVM_IMAGE_MEASUREMENT MUST be equal.
# App-image publication changes the digest ref and full Shade runtime policy,
# not the MRTD. See the runtime-image publication section of
# docs/production-deploy.md.
DEV_CVM_IMAGE=
DEV_CVM_IMAGE_MEASUREMENT=
SECURITY_CVM_IMAGE_REF=
SECURITY_CVM_IMAGE_MEASUREMENT=
