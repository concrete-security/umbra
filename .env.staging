# Staging environment template. Contains identifiers only, never secrets or
# personal data. Replace all reserved example values before deploying.
# Merged with .env.common + .env.admin + .env.staging.secrets; keys must be unique.
ENV=staging
# Use the production CA for a production-like attestation path. Set true while
# iterating if an untrusted Let's Encrypt staging certificate is acceptable.
LETSENCRYPT_STAGING=false
CONSOLE_HOST=console.staging.example.com
CONSOLE_URL=https://console.staging.example.com
VM_PUBLIC_IP=192.0.2.20
UMBRA_CLI_WORKFLOW_BRANCH=main
JWT_PRIVATE_KEY_REF=file:///etc/umbra/jwt/private-staging.pem
JWT_ACTIVE_KID=staging-key-1
# The supported publisher is GHCR-only. Replace the reserved owner.
SECURITY_CVM_IMAGE_REPOSITORY=ghcr.io/example/umbra-security-cvm-staging
DEV_CVM_IMAGE_REPOSITORY=ghcr.io/example/umbra-dev-cvm-staging
