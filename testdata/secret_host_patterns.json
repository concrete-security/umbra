{
  "description": "Shared verdict vector for the per-user-secret host-binding grammar. Authoritative implementation: valid_secret_host_pattern in console/src/umbra_console/profile_secrets.py. Client-side pre-flight mirror: valid_secret_host_pattern in cli/src/commands/secret.rs. Both are asserted against this same file so the grammars cannot drift silently: Python test test_host_pattern_shared_vector (console/tests/test_profile_secrets.py) and Rust test host_pattern_grammar_matches_shared_vector (cli/src/commands/secret.rs). If you change one grammar, update this vector and re-run BOTH suites.",
  "cases": [
    {
      "pattern": "*",
      "valid": true,
      "note": "bare wildcard: opt out of host binding"
    },
    {
      "pattern": "slack.com",
      "valid": true,
      "note": "apex, minimal two-label exact host"
    },
    {
      "pattern": "api.slack.com",
      "valid": true,
      "note": "three-label exact host"
    },
    {
      "pattern": "a.b.c.example.com",
      "valid": true,
      "note": "deep multi-label exact host"
    },
    {
      "pattern": "x1.example.com",
      "valid": true,
      "note": "digits allowed inside labels"
    },
    {
      "pattern": "a-b.example.com",
      "valid": true,
      "note": "internal hyphen allowed"
    },
    {
      "pattern": "*.slack.com",
      "valid": true,
      "note": "wildcard over a two-label suffix"
    },
    {
      "pattern": "*.a.slack.com",
      "valid": true,
      "note": "wildcard over a three-label suffix"
    },
    {
      "pattern": "",
      "valid": false,
      "note": "empty"
    },
    {
      "pattern": "*.",
      "valid": false,
      "note": "wildcard with empty suffix / trailing dot"
    },
    {
      "pattern": "*.com",
      "valid": false,
      "note": "wildcard suffix needs at least two labels"
    },
    {
      "pattern": "com",
      "valid": false,
      "note": "single-label (TLD alone)"
    },
    {
      "pattern": "localhost",
      "valid": false,
      "note": "single-label"
    },
    {
      "pattern": "Api.Slack.com",
      "valid": false,
      "note": "uppercase not allowed"
    },
    {
      "pattern": "api.slack.com.",
      "valid": false,
      "note": "trailing dot"
    },
    {
      "pattern": "-bad.example.com",
      "valid": false,
      "note": "label may not start with a hyphen"
    },
    {
      "pattern": "bad-.example.com",
      "valid": false,
      "note": "label may not end with a hyphen"
    },
    {
      "pattern": "foo_bar.example.com",
      "valid": false,
      "note": "underscore not allowed"
    },
    {
      "pattern": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com",
      "valid": false,
      "note": "label exceeds 63 characters (64 here)"
    },
    {
      "pattern": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com",
      "valid": false,
      "note": "host exceeds 253 characters (259 here)"
    }
  ]
}
