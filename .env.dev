# DEV environment vars (local developer host). Committed. NO secrets, NO personal/admin info.
# Same variables as .env.staging: ENV + LETSENCRYPT_STAGING have dev defaults below; the rest
# (CONSOLE_HOST/URL, VM IP, branch, JWT key) are left EMPTY — fill in for your local setup.
# Merged with .env.common + .env.admin + .env.dev.secrets. Every key must be UNIQUE across the
# four layers — build-env ABORTS on a key defined twice (no override). SHADE_DIR is per-host
# and lives in .env.admin; DATABASE_URL is the shared default in .env.common.
# ENV=dev is a per-environment label only (CVM names are hardcoded umbra-v0-*, not
# ENV-derived — see .env.<mode>.secrets Phala note). The reverse-proxy CA is chosen
# explicitly by LETSENCRYPT_STAGING below (true = Let's Encrypt staging CA, untrusted
# certs but no rate limits; false = real CA). See ops/reverse-proxy/entrypoint.sh.
ENV=dev
LETSENCRYPT_STAGING=true
CONSOLE_HOST=
CONSOLE_URL=
VM_PUBLIC_IP=
UMBRA_CLI_WORKFLOW_BRANCH=
JWT_PRIVATE_KEY_REF=
JWT_ACTIVE_KID=
SECURITY_CVM_IMAGE_REPOSITORY=
DEV_CVM_IMAGE_REPOSITORY=
