# Operator personal info + machine/registry creds. Per operator/host. gitignored.
# Copy to .env.admin and fill in real values. One of the four merged layers
# (.env.common + .env.<MODE> + .env.admin + .env.<MODE>.secrets); every key must be UNIQUE
# across them — build-env ABORTS on a key defined twice. NEVER commit the filled-in .env.admin.

# Per-host shade checkout (REQUIRED — no default; the path differs per operator/host).
# Used by redeploy-dev/redeploy-sc and `make verify`; an empty value fails them with
# "shade dir not found". Set the absolute path to your shade checkout. The commit
# at that path is pinned by SHADE_REF in .env.common; do not hand-edit the checkout.
SHADE_DIR=/absolute/path/to/shade

# TLS cert contact for the reverse proxy on HTTPS-terminating hosts (staging/prod VMs).
LETSENCRYPT_EMAIL=ops@your-org.example
# NOTE: the reverse-proxy CA choice (LETSENCRYPT_STAGING) is NOT here — it lives in the
# committed per-mode files (.env.dev/staging/prod). A key may live in only one layer.

# GHCR/GitHub publishing credentials are intentionally absent from every merged environment
# layer. Supply GHCR_USER + GHCR_TOKEN (image publication) or a dedicated GH_TOKEN (artifact
# access) only to the invoking process, preferably through a secret manager. build-env rejects
# those three keys so they cannot be forwarded to the Console or installer containers.

# Optional private runtime-image registry login. Leave all three values empty for the supported
# public images. A self-hoster opting into a private registry must set the complete trio; partial
# configuration fails before provisioning and none of these values may be logged.
DSTACK_DOCKER_REGISTRY=
DSTACK_DOCKER_USERNAME=
DSTACK_DOCKER_PASSWORD=

# `make verify` harness identity (per operator). Put real emails/names in .env.admin (gitignored),
# never in this committed template. DOMAIN RULES are enforced by the Console -- a mismatch aborts
# bootstrap ("admin email domain must match --domain") or user-add ("email_domain_mismatch"):
#   * BOOTSTRAP_ADMIN_EMAIL's domain MUST equal UMBRA_VERIFY_BOOTSTRAP_DOMAIN (.env.common;
#     `platform.umbra.invalid`). This is a SYNTHETIC platform-operator identity that NEVER logs in
#     via Google -- `make bootstrap` mints its session directly. Do NOT use a real email domain.
#   * TENANT_ADMIN_EMAIL and DEVELOPER_EMAIL MUST be REAL Google accounts whose domain equals
#     UMBRA_VERIFY_TENANT_DOMAIN (.env.common; replace the reserved `example.com` template)
#     -- they complete real Google OIDC logins.
UMBRA_VERIFY_BOOTSTRAP_ADMIN_EMAIL=admin@platform.umbra.invalid
UMBRA_VERIFY_BOOTSTRAP_ADMIN_NAME=Example Admin
UMBRA_VERIFY_TENANT_ADMIN_EMAIL=admin@example.com
UMBRA_VERIFY_TENANT_ADMIN_NAME=Tenant Admin
UMBRA_VERIFY_DEVELOPER_EMAIL=alice@example.com
UMBRA_VERIFY_DEVELOPER_NAME=Verify Developer
UMBRA_VERIFY_CLI_CONFIG_DIR=${HOME}/.umbra/platform
UMBRA_VERIFY_TENANT_ADMIN_CONFIG_DIR=${HOME}/.umbra/tenant
UMBRA_VERIFY_DEVELOPER_CONFIG_DIR=${HOME}/.umbra/developer

# redeploy-dev/sc live launch. CONFIG_DIR is an authenticated CLI config dir
# (tenant-admin session); PROFILE_ID / SSH_KEY_ID are Console-side UUIDs
# (`umbra profile list` / `umbra key list`).
UMBRA_REDEPLOY_SC_CONFIG_DIR=${HOME}/.umbra
UMBRA_REDEPLOY_DEV_CONFIG_DIR=${HOME}/.umbra
UMBRA_REDEPLOY_DEV_PROFILE_ID=00000000-0000-0000-0000-000000000000
UMBRA_REDEPLOY_DEV_SSH_KEY_ID=00000000-0000-0000-0000-000000000000
