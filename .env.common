# Shared defaults for all Umbra environments. This file contains no secrets.
# Merge it with .env.<mode>, .env.admin, and .env.<mode>.secrets by running:
#
#   make build-env MODE=<dev|staging|prod>
#
# Each key must occur in exactly one layer; build-env rejects duplicates.
JWT_ALGORITHM=EdDSA
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=umbra-console
JWT_AUDIENCE=umbra-console
JWT_LEEWAY_SECONDS=30
JWT_PUBLIC_KEYS_REF=file:///etc/umbra/jwt/public.jwks
OIDC_CLIENT_ALLOWLIST=umbra-cli-v1
OIDC_OVERRIDES_ALLOWED=false
PHALA_CLI_PATH=/usr/local/bin/phala
PHALA_CLI_VERSION=1.1.19
PHALA_CLI_SHA256=85a6c0b69d31338b8c33da82a73ebda4a74b6a8c1eafd0143c4bd32f6f802043
PHALA_REGION=FR-PARIS-1
PHALA_DEFAULT_INSTANCE_TYPE=tdx.small
ATLAS_VERIFIER_CMD=/usr/local/bin/umbra-atlas-verify
# Inactive until maintainers prove control of this repository and publish the
# first approved SLSA-bound release. Keep this exact identity aligned with the
# release workflow and verifier once that launch gate is satisfied.
UMBRA_CLI_RELEASE_SOURCE=github
UMBRA_CLI_RELEASE_GITHUB_REPO=concrete-security/umbra
UMBRA_CLI_WORKFLOW_NAME="Release Umbra CLI"
UMBRA_INSTALL_SLSA_VERIFIER=/usr/local/bin/slsa-verifier
DEV_CVM_DEFAULT_INSTANCE_TYPE=tdx.small
DEV_CVM_DEFAULT_REGION=FR-PARIS-1
SECURITY_CVM_DEFAULT_REGION=FR-PARIS-1
RECONCILER_INTERVAL_SECONDS=30
RECONCILER_ATTESTATION_INTERVAL_SECONDS=21600
DEV_CVM_ATTESTATION_TIMEOUT_SECONDS=600
SECURITY_CVM_ATTESTATION_TIMEOUT_SECONDS=600
OPERATION_RETENTION_DAYS=30
TRAFFIC_LOG_RETENTION_DAYS=90
LOG_LEVEL=info
TRUST_FORWARDED_HEADERS=false
# Documented for configuration parity; currently not consumed by Console code.
AUTO_PROVISION_SECURITY_CVM_ON_PROFILE_CREATE=false
UMBRA_ALLOW_BOOTSTRAP=false
AUDIT_ANCHOR_TARGET=
AUDIT_EXPORT_BUCKET=
SANDBOX_ENV_VALUE_DENYLIST='^sk-ant-[A-Za-z0-9_-]+$,^sk-[A-Za-z0-9]{32,}$,^gh[pousr]_[A-Za-z0-9]{36,}$,^AKIA[0-9A-Z]{16}$,^ASIA[0-9A-Z]{16}$'
# Local Compose default. Remove this line and define DATABASE_URL in the mode
# layer when using an external database; do not define it in two layers.
DATABASE_URL=postgresql+asyncpg://umbra:umbra@console-db:5432/umbra
# Non-secret verifier fixtures. Replace the reserved example tenant with a real
# OIDC-enabled domain in a deployment-specific private layer when running the
# live journey.
UMBRA_VERIFY_BOOTSTRAP_DOMAIN=platform.umbra.invalid
UMBRA_VERIFY_BOOTSTRAP_ENTITY_NAME="Umbra Platform"
UMBRA_VERIFY_BOOTSTRAP_DEFAULT_PROFILE=default
UMBRA_VERIFY_TENANT_DOMAIN=example.com
UMBRA_VERIFY_TENANT_NAME="Example Corp"
