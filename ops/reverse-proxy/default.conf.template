log_format umbra_no_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                             '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    server_name ${CONSOLE_HOST};
    access_log /var/log/nginx/access.log umbra_no_query;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${CONSOLE_HOST};
    access_log /var/log/nginx/access.log umbra_no_query;

    ssl_certificate /etc/letsencrypt/live/${CONSOLE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CONSOLE_HOST}/privkey.pem;

    location / {
        proxy_pass http://console:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
